# ===========================================================================
# Multilingual file for the TOS 7 Docker application "docmostdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Docmost"
auth         = "Docmost"
version      = "@@VERSION@@"
descript     = "Docmost is a self-hosted team wiki and documentation platform: spaces, nested pages, real-time co-editing, comments, page permissions, attachments, full-text search, version history and public sharing. This package runs the official Docker Hub image with its own PostgreSQL database and Redis cache as non-root containers; pages, attachments and accounts stay in the application data folder."
release_note = "Rectified per review comments (C3 C4 C5 C7 C9 C10 F1 F5 T1): added a complete privacy policy covering pages, attachments, accounts, sessions and WebSocket collaboration; rewrote the descriptions and the 23-language file; completed README, NOTICE and the repository layout; hardened the three-container stack (pinned images, per-service healthchecks, longer first-start grace, telemetry disabled, Redis AOF); T1 addressed with the current upstream 0.90.0 image and pinned PostgreSQL 16.16 / Redis 8.10.3 patch releases."
important    = "Requires DockerEngine. Complete the first-run wizard to create the workspace and administrator account. Accounts, pages, comments, attachments and permissions are stored under DockerAppData/docmostdocker/ and survive restarts and updates. No mail server is configured by default: invitation and reset links go to the container log; configure SMTP for delivery. The UI is plain HTTP on the LAN - use a TLS reverse proxy before internet exposure. Deleting the data folder on uninstall erases everything."

[zh-cn]
name         = "Docmost"
auth         = "Docmost"
version      = "@@VERSION@@"
descript     = "Docmost 是自建的团队 Wiki 与文档协作平台：空间、嵌套页面、多人实时协同编辑、评论、页面权限、附件、全文检索、版本历史与公开分享。所有内容保存在 NAS 的应用数据目录，数据库与缓存仅容器内部访问，容器以非 root 运行。"
release_note = "按上轮审核意见整改（C3/C4/C5/C7/C9/C10/F1/F5/T1）：补全隐私政策，覆盖页面、附件、账号、会话与 WebSocket 协同；重写描述与 23 语文件；补全 README、NOTICE 与仓库目录结构；加固三容器栈（固定镜像、逐服务健康检查、延长首次启动宽限、关闭遥测、Redis 开启 AOF）；T1 采用当前上游 0.90.0 并固定 PostgreSQL 16.16 / Redis 8.10.3 补丁版本。"
important    = "需要 DockerEngine。首次打开按向导创建工作区与管理员账号；账号、页面、评论、附件与权限保存在 DockerAppData/docmostdocker/，重启和升级不丢失。默认未配置邮件服务，邀请/重置链接写入容器日志，正式使用请配置 SMTP。界面为 HTTP，公网访问前请加 TLS 反向代理。卸载时删除数据目录会永久清除全部内容。"

[zh-hk]
name         = "Docmost"
auth         = "Docmost"
version      = "@@VERSION@@"
descript     = "Docmost 是自建的團隊 Wiki 與文件協作平台：空間、巢狀頁面、多人即時協同編輯、留言、頁面權限、附件、全文檢索、版本歷史與公開分享。所有內容保存在 NAS 的應用資料目錄，資料庫與快取僅容器內部存取，容器以非 root 執行。"
release_note = "依上輪審核意見整改（C3/C4/C5/C7/C9/C10/F1/F5/T1）：補齊隱私政策，涵蓋頁面、附件、帳號、工作階段與 WebSocket 協同；重寫描述與 23 語檔案；補齊 README、NOTICE 與倉庫目錄結構；加固三容器棧（固定映像、逐服務健康檢查、延長首次啟動寬限、關閉遙測、Redis 啟用 AOF）；T1 採用目前上游 0.90.0 並固定 PostgreSQL 16.16 / Redis 8.10.3 修補版本。"
important    = "需要 DockerEngine。首次開啟依精靈建立工作區與管理員帳號；帳號、頁面、留言、附件與權限保存在 DockerAppData/docmostdocker/，重新啟動和升級不會遺失。預設未設定郵件服務，邀請/重設連結會寫入容器日誌，正式使用請設定 SMTP。介面為 HTTP，公開到互聯網前請加 TLS 反向代理。解除安裝時刪除資料目錄會永久清除全部內容。"

